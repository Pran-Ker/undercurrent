# The database: a local file for development and tests, or the Turso database.
UNDERCURRENT_DB=file:undercurrent.db
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# The port the backend listens on.
PORT=8787

# The agent that runs committed tasks: a command that reads the prompt on stdin and prints its
# answer. Claude Code by default; `codex exec` or `opencode run` work the same way.
AGENT_CMD="claude -p --output-format json"

# Phase 1.5 — off until the keys exist.
# KEEWANO_API_KEY=
# ALIKE_MCP_URL=
# ALIKE_TOKEN=

# Phase 2 — the live agent.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# LIVE_TOOL_SECRET=
# PUBLIC_URL=https://<tunnel to this machine>
# DIAL_API_KEY=
# DIAL_NUMBER=
