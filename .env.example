# The database: a local file for development and tests, or the Turso database.
UNDERCURRENT_DB=file:undercurrent.db
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

PORT=8787

# The agent that runs committed tasks: reads the prompt on stdin, prints its answer, ends with the
# UNDERCURRENT: verdict line. Claude Code by default; `opencode run` works the same way.
AGENT_CMD="claude -p --output-format json"

# The chat model for retransforms (any OpenAI-compatible endpoint with JSON mode).
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# Recall also reads coding-agent conversations (JSONL) from this folder, newest first.
# ORACLE_TRANSCRIPTS=~/.claude/projects/<your project folder>

# The live agent (ElevenLabs). The tools call back to PUBLIC_URL/live/tools/<name> with the secret.
# LIVE_TOOL_SECRET=
# PUBLIC_URL=https://<a tunnel to this machine>
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=            # printed by `undercurrent elevenlabs sync`
# ELEVENLABS_WEBHOOK_SECRET=      # the post-call webhook secret from the dashboard

# Keewano: typed events, categories and counts only. Off without the SDK key.
# KEEWANO_SDK_KEY=
