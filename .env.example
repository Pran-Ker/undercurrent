# The database: a local file for development and tests, or the Turso database.
UNDERCURRENT_DB=file:undercurrent.db
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

PORT=8787

# The agent that runs committed tasks: reads the prompt on stdin, prints its answer, ends with the
# UNDERCURRENT: verdict line. Claude Code by default; `opencode run` works the same way.
AGENT_CMD="claude -p --output-format json"
# Where it runs: a scratch folder, so no project hooks, settings or files are in its way.
# AGENT_DIR=/tmp/undercurrent-agent

# The chat model for retransforms (any OpenAI-compatible endpoint with JSON mode).
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# Recall also reads coding-agent conversations (JSONL) from this folder, newest first.
# ORACLE_TRANSCRIPTS=~/.claude/projects/<your project folder>

# The voice agent (ElevenLabs). Its tools are client tools, run by the board page or the app against
# this backend with the secret; no public URL is needed.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=            # printed by `undercurrent elevenlabs sync`
# LIVE_TOOL_SECRET=               # any string; the page reads it from /live/config
# ELEVENLABS_WEBHOOK_SECRET=      # only if you also point a post-call webhook here from the dashboard

# Keewano: typed events, categories and counts only. Off without a key. The event routes take a
# project API key of type SDK (console: Settings → API Keys); a Server key or a PAT is refused (403).
# KEEWANO_SDK_KEY=

# Dial: a committed task that names a phone number (+1…) is placed as a call on your behalf; the
# transcript comes back as a "Review call notes" task. Off without the key.
# DIAL_API_KEY=                   # sk_live_…, saved by `dial auth` (see README)
# DIAL_FROM_NUMBER=               # one of your Dial numbers, E.164; omit to let Dial choose
# DIAL_BASE_URL=https://api.getdial.ai
