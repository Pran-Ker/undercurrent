# Copy to scripts/.env.local (gitignored). What deploy_phone.sh needs to know about this Mac and phone.
DEVICE_UUID=                      # xcrun devicectl list devices
BUNDLE_ID=com.hebbarpran.undercurrent   # or an app id you already have an ad-hoc profile for
PROFILE=undercurrent-adhoc        # ~/Library/MobileDevice/Provisioning Profiles/<PROFILE>.mobileprovision
IDENTITY="Apple Distribution: <name> (<team id>)"   # security find-identity -v -p codesigning
APPLE_TEAM_ID=
BACKEND_URL=http://<your mac>.local:8790   # how the phone reaches the backend on this Mac
